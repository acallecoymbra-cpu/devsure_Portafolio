APP_NAME="Sinaloa Nube"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mazatlan

APP_MAINTENANCE_DRIVER=file

# Clave permanente y exclusiva para cifrar credenciales de integraciones.
# Generar con: php artisan key:generate --show
INTEGRATIONS_ENCRYPTION_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos -----------------------------------------------------------
# SQLite (por defecto, no requiere servidor):
DB_CONNECTION=sqlite

# MySQL / MariaDB (descomentar y comentar la linea de arriba):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sinaloanube
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync = los avisos salen durante la peticion (no necesita worker).
# database = se encolan; requiere "php artisan queue:work" corriendo.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# --- Correo ------------------------------------------------------------------
# En local "log" escribe los correos en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sinaloanube.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
