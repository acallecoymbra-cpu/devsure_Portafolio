# Archivos que sube el equipo desde el panel (disco "publico").
# Viven en el servidor, no en el repo: el deploy corre sin --delete y los respeta.
/public/img/casos
/public/img/clientes
/public/img/marca
/public/img/portada

# Assets compilados de Filament: los publica "filament:assets" en cada deploy.
/public/css/filament
/public/js/filament
/public/fonts/filament

# Base de datos local de desarrollo.
/database/database.sqlite

# Datos de demostración opcionales, instalados sólo en los entornos que los usan.
/database/seeders/ContenidoDeEjemploSeeder.php

